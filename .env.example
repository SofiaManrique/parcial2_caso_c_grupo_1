# ── Template de variables de entorno ─────────────────────────
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env al repositorio.

# Base de datos
DB_PASSWORD=

# JWT — genera con: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# MFA Fernet — genera con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_FERNET_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_URL=

# Wazuh Cloud (opcional)
WAZUH_MANAGER=
WAZUH_REGISTRATION_PASSWORD=
